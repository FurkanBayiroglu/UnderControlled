{
  "name": "undercontrol-ai-backend",
  "version": "2.0.0",
  "description": "AI Backend for UnderControl App",
  "main": "dist/index.js",
  "scripts": {
    "dev": "ts-node-dev -r dotenv/config --respawn src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "deploy": "npm run build && serverless deploy"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^4.18.2",
    "firebase-admin": "^12.0.0",
    "groq-sdk": "^0.5.0",
    "helmet": "^7.1.0",
    "serverless-http": "^3.2.0",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.10.0",
    "@types/uuid": "^9.0.7",
    "serverless": "^3.38.0",
    "serverless-offline": "^13.3.0",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.3.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
