# Groq API Key (https://console.groq.com adresinden al)
GROQ_API_KEY=gsk_your_api_key_here

# Firebase Project ID
FIREBASE_PROJECT_ID=undercontrolled-f1948

# Firebase Service Account JSON (tek satırda, tüm JSON)
# Önemli: JSON'u tek satıra çevirip buraya yapıştır
# Online converter: https://www.freeformatter.com/json-formatter.html -> Compact
FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"undercontrolled-f1948","private_key_id":"xxx","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"firebase-adminsdk-xxx@undercontrolled-f1948.iam.gserviceaccount.com","client_id":"xxx","auth_uri":"https://accounts.google.com/o/oauth2/auth","token_uri":"https://oauth2.googleapis.com/token","auth_provider_x509_cert_url":"https://www.googleapis.com/oauth2/v1/certs","client_x509_cert_url":"https://www.googleapis.com/robot/v1/metadata/x509/firebase-adminsdk-xxx%40undercontrolled-f1948.iam.gserviceaccount.com","universe_domain":"googleapis.com"}

# Environment
NODE_ENV=development
PORT=3000
